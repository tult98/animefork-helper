{
  "manifest_version": 3,
  "name": "Animefork Helper",
  "description": "Lets the Animefork web app load anime from sites that block cross-origin requests.",
  "version": "1.0.55",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": ["cookies", "declarativeNetRequest", "storage"],
  "host_permissions": ["*://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["embed.js", "page-patch.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{26005fb7-3d84-4144-a688-a058944123b3}",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["content-scripts/inject.js"]
    },
    {
      "matches": [
        "http://animefork.com/*",
        "http://localhost/*",
        "https://animefork.com/*",
        "https://localhost/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["content-scripts/relay.js"]
    }
  ]
}
