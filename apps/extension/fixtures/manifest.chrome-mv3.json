{
  "manifest_version": 3,
  "name": "Animefork Helper",
  "description": "Extension add API helper for AnimeVsub",
  "version": "1.0.52",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "cookies",
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": ["*://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["embed.js", "page-patch.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["content-scripts/inject.js"]
    },
    {
      "matches": [
        "http://animefork.com/*",
        "http://localhost/*",
        "https://animefork.com/*",
        "https://localhost/*"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": ["content-scripts/relay.js"]
    }
  ]
}
